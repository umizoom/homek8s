{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Flux controllers: one PR for all gotk-components.yaml updates",
      "matchFileNames": [
        "clusters/**/flux-system/gotk-components.yaml"
      ],
      "groupName": "flux"
    }
  ]
}
