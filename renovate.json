{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Flux controllers: one PR for all gotk-components.yaml updates",
      "matchFileNames": [
        "clusters/**/flux-system/gotk-components.yaml"
      ],
      "groupName": "flux"
    },
    {
      "description": "Kubernetes components: one PR for all control-plane and kubelet image updates",
      "matchPackageNames": [
        "ghcr.io/siderolabs/kubelet",
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-scheduler",
        "registry.k8s.io/kube-proxy"
      ],
      "groupName": "kubernetes"
    },
    {
      "description": "Prowlarr: track hotio release-<version> tags and pull notes from upstream Prowlarr",
      "matchPackageNames": [
        "ghcr.io/hotio/prowlarr"
      ],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
      "sourceUrl": "https://github.com/Prowlarr/Prowlarr"
    },
    {
      "description": "Calibre-web: track <version>-ls<build> tags so LinuxServer rebuilds are version bumps with release notes",
      "matchPackageNames": [
        "lscr.io/linuxserver/calibre-web"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "description": "Homebridge: track stable YYYY-MM-DD tags (excludes alpha/beta/legacy)",
      "matchPackageNames": [
        "ghcr.io/homebridge/homebridge"
      ],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$",
      "sourceUrl": "https://github.com/homebridge/docker-homebridge"
    }
  ]
}
