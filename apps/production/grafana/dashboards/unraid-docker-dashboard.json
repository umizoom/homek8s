    {
      "id": 52,
      "type": "bargauge",
      "title": "Busiest disks (I/O busy %)",
      "description": "Share of the selected time range each spinning disk spent doing I/O. Highest = most active. Devices are sdX names; letters can change after a reboot, see Unraid's Main tab for the disk mapping.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "100 * sum by (device) (increase(node_disk_io_time_seconds_total{job=\"unraid-nodeexporter\"}[$__range]) and on(device,instance) (node_disk_ata_rotation_rate_rpm{job=\"unraid-nodeexporter\"} > 0)) / $__range_s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{device}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8
      }
    },
    {
      "id": 53,
      "type": "bargauge",
      "title": "Disk spin-downs (\u2248 spin-ups)",
      "description": "Times each disk spun down in the selected range. Every spin-down follows a spin-up, so this approximates spin-ups. Source: Unraid syslog (Loki), history starts when syslog forwarding was enabled.",
      "datasource": {
        "type": "loki",
        "uid": "loki-unraid"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "targets": [
        {
          "expr": "sum by (disk) (count_over_time({job=\"unraid-syslog\", app=\"emhttpd\"} |= \"spinning down\" | regexp \"spinning down /dev/(?P<disk>[a-z0-9]+)\" [$__range]))",
          "datasource": {
            "type": "loki",
            "uid": "loki-unraid"
          },
          "legendFormat": "{{disk}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "namePlacement": "auto",
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8
      }
    },
    {
      "id": 54,
      "type": "timeseries",
      "title": "Disk throughput (read + write)",
      "description": "Combined read and write rate per spinning disk.",
      "datasource": {
        "type": "prometheus",
